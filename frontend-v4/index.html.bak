<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReguLens — Verifiable Compliance Intelligence</title>
  <style>
    :root {
      --bg-color: #050505;
      --card-bg: #0d0d0d;
      --border-color: #1a1a1a;
      --text-primary: #ffffff;
      --text-secondary: #888888;
      --text-muted: #444444;
      --accent-gold: #d4af37;
      --accent-green: #00ff66;
      --accent-orange: #ff9900;
      --accent-red: #ff3333;
      --font-mono: 'Courier New', Courier, monospace;
      --font-serif: 'Georgia', serif;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background-color: var(--bg-color);
      color: var(--text-primary);
      font-family: var(--font-sans);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }

    /* ── NAV ── */
    #nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 1000;
      padding: 2rem 4rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: background 0.3s ease;
    }
    #nav.scrolled { background: #0d0d0d; }

    .nav-logo {
      font-family: var(--font-sans);
      font-size: 1.5rem;
      font-weight: 500;
      color: var(--text-primary);
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }
    .nav-links a {
      font-size: 0.9rem;
      color: var(--text-secondary);
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text-primary); }

    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 4px;
    }
    .hamburger span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--text-primary);
      transition: 0.3s;
    }

    #mobile-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 999;
      background: var(--bg-color);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
    }
    #mobile-overlay.open { display: flex; }
    #mobile-overlay a {
      font-size: 1.5rem;
      color: var(--text-secondary);
    }
    #mobile-overlay a:hover { color: var(--text-primary); }
    #close-overlay {
      position: absolute;
      top: 2rem; right: 2rem;
      background: none;
      border: none;
      color: var(--text-primary);
      font-size: 1.5rem;
      cursor: pointer;
    }

    /* ── HERO ── */
    #hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      overflow: hidden;
    }

    #matrix {
      position: absolute;
      inset: 0;
      opacity: 0.15;
      pointer-events: none;
      overflow: hidden;
    }

    .matrix-col {
      position: absolute;
      top: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    @keyframes fall {
      from { transform: translateY(-10%); }
      to   { transform: translateY(110vh); }
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.3; }
    }

    .hero-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-tagline {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #888;
      margin-bottom: 1.5rem;
    }

    .hero-h1 {
      font-family: var(--font-serif);
      font-size: 3.5rem;
      font-weight: 400;
      max-width: 800px;
      margin-bottom: 1.5rem;
      line-height: 1.2;
    }

    .hero-sub {
      color: #888;
      max-width: 600px;
      margin-bottom: 3rem;
      font-size: 1.1rem;
    }

    .btn-outline {
      font-family: var(--font-mono);
      background: transparent;
      border: 1px solid #444;
      border-radius: 20px;
      padding: 0.8rem 2rem;
      color: var(--text-primary);
      cursor: pointer;
      font-size: 0.9rem;
      transition: border-color 0.2s, background 0.2s;
    }
    .btn-outline:hover {
      border-color: #fff;
      background: rgba(255, 255, 255, 0.05);
    }

    /* ── SECTION SHARED ── */
    .section-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 6rem 2rem;
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #888;
      margin-bottom: 1.5rem;
    }

    .section-heading {
      font-family: var(--font-serif);
      font-size: 2.8rem;
      font-weight: 400;
      margin-bottom: 2rem;
    }

    .section-desc {
      color: #888;
      max-width: 700px;
      margin-bottom: 4rem;
      font-size: 1rem;
    }

    /* ── SCROLL REVEAL ── */
    .scroll-reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .scroll-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ── METRICS ── */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .metric-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      padding: 3rem 2rem;
      border-radius: 4px;
    }
    .metric-card h3 {
      font-family: var(--font-sans);
      font-size: 2.2rem;
      font-weight: 500;
      margin-bottom: 1rem;
    }
    .metric-card p {
      color: #888;
      font-size: 0.95rem;
    }
    .metric-gold h3 { color: var(--accent-gold); }

    /* ── QUERY ── */
    .query-section-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem 6rem 2rem;
    }

    .persona-toggles {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .persona-btn {
      font-family: var(--font-mono);
      background: transparent;
      border: 1px solid #444;
      border-radius: 4px;
      padding: 0.5rem 1.2rem;
      color: #888;
      cursor: pointer;
      font-size: 0.85rem;
      transition: border-color 0.2s, color 0.2s;
    }
    .persona-btn.active {
      border-color: #fff;
      color: #fff;
    }
    .persona-btn:hover:not(.active) {
      border-color: #666;
      color: #aaa;
    }

    .query-textarea {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      color: var(--text-primary);
      font-family: var(--font-sans);
      padding: 1.2rem;
      border-radius: 4px;
      width: 100%;
      min-height: 100px;
      resize: vertical;
      font-size: 0.95rem;
      display: block;
    }
    .query-textarea:focus {
      border-color: #444;
      outline: none;
    }
    .query-textarea::placeholder { color: var(--text-muted); }

    .submit-btn {
      font-family: var(--font-mono);
      background: transparent;
      border: 1px solid #888;
      color: var(--text-primary);
      padding: 0.8rem 2rem;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.9rem;
      margin-top: 1rem;
      transition: border-color 0.2s;
    }
    .submit-btn:hover:not(:disabled) { border-color: #fff; }
    .submit-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    #loading-state { display: none; margin-top: 1.5rem; }

    .loading-step {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: #444;
      margin-bottom: 0.5rem;
      transition: color 0.3s;
    }
    .loading-step.active { color: var(--accent-gold); }
    .loading-dot { display: inline-block; }
    .loading-dot.pulsing { animation: pulse 1s infinite; }

    #cold-start-msg {
      display: none;
      color: var(--accent-orange);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      margin-top: 1rem;
    }

    /* ── VERIFICATION TABLE ── */
    .results-section-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem 6rem 2rem;
    }

    .results-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 2.5rem;
    }

    .meta-bar {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 2rem;
      margin-bottom: 2rem;
      font-family: var(--font-mono);
      font-size: 0.8rem;
    }
    .meta-item label {
      display: block;
      color: #444;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 0.25rem;
    }
    .meta-item span { color: #888; }

    .verify-table {
      width: 100%;
      border-collapse: collapse;
    }
    .verify-table th {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: #444;
      text-transform: uppercase;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
      padding: 1rem 0.75rem;
      letter-spacing: 1px;
    }
    .verify-table td {
      padding: 1rem 0.75rem;
      border-bottom: 1px solid rgba(26,26,26,0.5);
      font-size: 0.9rem;
      vertical-align: top;
    }
    .verify-table tr:last-child td { border-bottom: none; }

    .verdict-tag {
      font-family: var(--font-mono);
      font-weight: bold;
      font-size: 0.8rem;
      padding: 0.2rem 0.6rem;
      border-radius: 3px;
      white-space: nowrap;
    }
    .verdict-PASS { background: rgba(0,255,102,0.1); color: #00ff66; }
    .verdict-FLAG { background: rgba(255,153,0,0.1); color: #ff9900; }
    .verdict-BLOCK { background: rgba(255,51,51,0.1); color: #ff3333; }

    .flag-sub {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--accent-red);
      margin-top: 0.3rem;
    }

    .table-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid var(--border-color);
      padding-top: 2rem;
      margin-top: 1rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .footer-overall {
      font-family: var(--font-mono);
      font-weight: bold;
      color: var(--accent-orange);
    }
    .footer-counts {
      font-family: var(--font-mono);
      color: #888;
    }
    .footer-audit {
      font-family: var(--font-mono);
      color: #444;
      font-size: 0.8rem;
      width: 100%;
    }

    /* ── CAPABILITIES ── */
    .capabilities-rows { border-top: 1px solid var(--border-color); }

    .cap-row {
      border-bottom: 1px solid var(--border-color);
      padding: 2rem 0;
    }
    .cap-row h3 {
      font-family: var(--font-serif);
      font-size: 1.3rem;
      margin-bottom: 0.5rem;
    }
    .cap-row p {
      color: #888;
      font-size: 0.95rem;
      max-width: 700px;
    }

    /* ── PERSONAS ── */
    .personas-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .persona-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      padding: 2.5rem;
      border-radius: 4px;
    }
    .persona-card h3 {
      font-family: var(--font-sans);
      font-size: 1.2rem;
      font-weight: 500;
      margin-bottom: 0.25rem;
    }
    .persona-role {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: #888;
      margin-bottom: 1.5rem;
      display: block;
    }
    .threshold-badge {
      font-family: var(--font-mono);
      color: var(--accent-gold);
      border: 1px solid rgba(212,175,55,0.3);
      background: rgba(212,175,55,0.05);
      padding: 0.2rem 0.6rem;
      border-radius: 3px;
      font-size: 0.85rem;
      display: inline-block;
      margin-bottom: 1rem;
    }
    .persona-desc {
      color: #888;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }
    .output-label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: #444;
      text-transform: uppercase;
      letter-spacing: 1px;
      display: block;
      margin-bottom: 0.25rem;
    }
    .output-value {
      font-size: 0.85rem;
      color: #888;
    }

    /* ── ARCHITECTURE ── */
    .arch-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .arch-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      padding: 2.5rem;
      border-radius: 4px;
    }
    .arch-label {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #444;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 0.5rem;
    }
    .arch-name {
      font-family: var(--font-serif);
      font-size: 1.3rem;
      margin-bottom: 1rem;
    }
    .arch-desc {
      color: #888;
      font-size: 0.9rem;
    }

    /* ── CORPUS ── */
    .corpus-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .corpus-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      padding: 2.5rem;
      border-radius: 4px;
    }
    .corpus-card h3 {
      font-family: var(--font-serif);
      font-size: 1.3rem;
      margin-bottom: 0.25rem;
    }
    .corpus-subtitle {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: #888;
      display: block;
      margin-bottom: 1rem;
    }
    .corpus-detail { color: #444; font-size: 0.9rem; }

    /* ── FOOTER ── */
    #footer {
      border-top: 1px solid var(--border-color);
      background: var(--bg-color);
      padding: 4rem 2rem;
    }
    .footer-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 3rem;
    }
    .footer-brand h4 {
      font-family: var(--font-sans);
      font-size: 1.2rem;
      font-weight: 500;
      margin-bottom: 1rem;
    }
    .footer-brand p {
      color: #888;
      font-size: 0.9rem;
    }
    .footer-col h5 {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #444;
      margin-bottom: 1rem;
    }
    .footer-col a {
      color: #888;
      font-size: 0.9rem;
      display: block;
      margin-bottom: 0.5rem;
      transition: color 0.2s;
    }
    .footer-col a:hover { color: var(--text-primary); }
    .footer-legal { color: #444; font-size: 0.85rem; margin-bottom: 1rem; }
    .footer-version {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #333;
    }

    /* ── MOBILE ── */
    @media (max-width: 768px) {
      #nav { padding: 1.5rem 2rem; }
      .nav-links { display: none; }
      .hamburger { display: flex; }

      .hero-h1 { font-size: 2.2rem; }

      .section-wrap { padding: 4rem 1.5rem; }
      .query-section-wrap { padding: 0 1.5rem 4rem 1.5rem; }
      .results-section-wrap { padding: 0 1.5rem 4rem 1.5rem; }

      .metrics-grid { grid-template-columns: 1fr; }
      .personas-grid { grid-template-columns: 1fr; }
      .arch-grid { grid-template-columns: 1fr; }
      .corpus-grid { grid-template-columns: 1fr; }

      .meta-bar { grid-template-columns: repeat(2, 1fr); }

      .footer-inner { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 480px) {
      .footer-inner { grid-template-columns: 1fr; }
      .meta-bar { grid-template-columns: 1fr; }
      .table-footer { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>

<!-- ── MOBILE OVERLAY ── -->
<div id="mobile-overlay">
  <button id="close-overlay" aria-label="Close menu">&#x2715;</button>
  <a href="#metrics" class="overlay-link">How It Works</a>
  <a href="#capabilities" class="overlay-link">Use Cases</a>
  <a href="#architecture" class="overlay-link">About</a>
</div>

<!-- ── NAV ── -->
<nav id="nav">
  <div class="nav-logo">ReguLens</div>
  <ul class="nav-links">
    <li><a href="#metrics">How It Works</a></li>
    <li><a href="#capabilities">Use Cases</a></li>
    <li><a href="#architecture">About</a></li>
  </ul>
  <button class="hamburger" id="hamburger" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- ── HERO ── -->
<section id="hero">
  <div id="matrix" aria-hidden="true"></div>
  <div class="hero-content">
    <p class="hero-tagline">Verifiable Compliance Intelligence</p>
    <h1 class="hero-h1">From regulatory text to verified claims.</h1>
    <p class="hero-sub">ReguLens decomposes compliance questions into atomic claims, verifies each against a frozen regulatory corpus, and returns structured intelligence with NLI confidence scores.</p>
    <button class="btn-outline" onclick="document.getElementById('architecture').scrollIntoView({behavior:'smooth'})">View Architecture</button>
  </div>
</section>

<!-- ── METRICS ── -->
<section id="metrics">
  <div class="section-wrap scroll-reveal">
    <p class="section-label">The Numbers</p>
    <div class="metrics-grid">
      <div class="metric-card metric-gold">
        <h3>278</h3>
        <p>Regulatory chunks indexed across EU AI Act, NIST AI RMF 1.0, and ISO 42001</p>
      </div>
      <div class="metric-card">
        <h3>3</h3>
        <p>Agents in the verification pipeline: Horizon Ingestion, Persona Synthesis, Zero-Trust Critic</p>
      </div>
      <div class="metric-card">
        <h3>0.96</h3>
        <p>NLI confidence threshold for Lead Auditor and Legal Counsel personas. ML Engineer threshold: 0.88</p>
      </div>
    </div>
  </div>
</section>

<!-- ── LIVE QUERY ── -->
<section id="query">
  <div class="query-section-wrap scroll-reveal">
    <p class="section-label">Live Verification</p>
    <h2 class="section-heading">Query the regulatory corpus.</h2>

    <div class="persona-toggles" id="persona-toggles">
      <button class="persona-btn active" data-persona="lead_auditor">Lead Auditor</button>
      <button class="persona-btn" data-persona="ml_engineer">ML Engineer</button>
      <button class="persona-btn" data-persona="legal_counsel">Legal Counsel</button>
    </div>

    <textarea
      class="query-textarea"
      id="query-input"
      placeholder="Enter your compliance question..."
    ></textarea>

    <button class="submit-btn" id="submit-btn" onclick="runVerification()">Run Verification</button>

    <div id="loading-state">
      <div class="loading-step" id="step-1"><span class="loading-dot">&#9679;</span> Agent I &#8212; Horizon Ingestion: retrieving corpus chunks...</div>
      <div class="loading-step" id="step-2"><span class="loading-dot">&#9679;</span> Agent II &#8212; Persona Synthesis: synthesizing response...</div>
      <div class="loading-step" id="step-3"><span class="loading-dot">&#9679;</span> Agent III &#8212; Zero-Trust Critic: verifying claims...</div>
    </div>
    <div id="cold-start-msg">&#9888; Waking API &#8212; Render free tier cold start. Retrying in 30s...</div>
  </div>
</section>

<!-- ── VERIFICATION TABLE ── -->
<section id="results">
  <div class="results-section-wrap scroll-reveal">
    <p class="section-label">Verification Output</p>
    <h2 class="section-heading">Every claim traced to source.</h2>

    <div class="results-card">
      <div class="meta-bar" id="meta-bar">
        <div class="meta-item"><label>Query</label><span id="meta-query">Article 9 risk management requirements</span></div>
        <div class="meta-item"><label>Persona</label><span id="meta-persona">lead_auditor</span></div>
        <div class="meta-item"><label>Threshold</label><span id="meta-threshold">0.96</span></div>
        <div class="meta-item"><label>Framework</label><span id="meta-framework">EU AI Act</span></div>
      </div>

      <div style="overflow-x:auto;">
        <table class="verify-table" id="verify-table">
          <thead>
            <tr>
              <th>Claim</th>
              <th>Source</th>
              <th>Confidence</th>
              <th>Verdict</th>
            </tr>
          </thead>
          <tbody id="table-body">
            <tr>
              <td>Risk management system must be established and maintained</td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">Article 9 &#167;1</td>
              <td style="font-family:var(--font-mono);font-size:0.85rem;">1.000</td>
              <td><span class="verdict-tag verdict-PASS">PASS</span></td>
            </tr>
            <tr>
              <td>System must identify known and foreseeable risks</td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">Article 9 &#167;2(a)</td>
              <td style="font-family:var(--font-mono);font-size:0.85rem;">0.987</td>
              <td><span class="verdict-tag verdict-PASS">PASS</span></td>
            </tr>
            <tr>
              <td>
                Residual risks must be communicated to users
                <span class="flag-sub">below 0.96 threshold</span>
              </td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">Article 9 &#167;4</td>
              <td style="font-family:var(--font-mono);font-size:0.85rem;">0.923</td>
              <td><span class="verdict-tag verdict-FLAG">FLAG</span></td>
            </tr>
            <tr>
              <td>Risk management applies to the full AI lifecycle</td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">Article 9 &#167;1</td>
              <td style="font-family:var(--font-mono);font-size:0.85rem;">0.971</td>
              <td><span class="verdict-tag verdict-PASS">PASS</span></td>
            </tr>
            <tr>
              <td>Annual third-party audit required for all systems</td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">Article 9</td>
              <td style="font-family:var(--font-mono);font-size:0.85rem;">0.410</td>
              <td><span class="verdict-tag verdict-BLOCK">BLOCK</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="table-footer">
        <span class="footer-overall" id="footer-overall">OVERALL: VERIFIED WITH FLAGS</span>
        <span class="footer-counts" id="footer-counts">3 PASS &#183; 1 FLAG &#183; 1 BLOCK</span>
        <span class="footer-audit" id="footer-audit"></span>
      </div>
    </div>
  </div>
</section>

<!-- ── CAPABILITIES ── -->
<section id="capabilities">
  <div class="section-wrap scroll-reveal">
    <p class="section-label">Capabilities</p>
    <h2 class="section-heading" style="max-width:600px;">Built for regulated industries.</h2>
    <div class="capabilities-rows">
      <div class="cap-row">
        <h3>Tri-Agent Verification Pipeline</h3>
        <p>Three specialized agents handle ingestion, synthesis, and zero-trust verification independently. No shared runtime state.</p>
      </div>
      <div class="cap-row">
        <h3>Persona-Aware Thresholds</h3>
        <p>Lead Auditor and Legal Counsel operate at 0.96 NLI confidence. ML Engineer at 0.88. Asymmetric by design.</p>
      </div>
      <div class="cap-row">
        <h3>Frozen Corpus Architecture</h3>
        <p>Regulatory text is ingested once, versioned with SHA-256, and never modified. Every claim traces to an immutable source.</p>
      </div>
      <div class="cap-row">
        <h3>Gap Report Generation</h3>
        <p>When no claims pass the verification threshold, ReguLens generates a structured gap report identifying what the corpus does not cover.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── PERSONAS ── -->
<section id="personas">
  <div class="section-wrap scroll-reveal">
    <p class="section-label">Who It's For</p>
    <h2 class="section-heading">Three personas. One platform.</h2>
    <div class="personas-grid">
      <div class="persona-card">
        <h3>Lead Auditor</h3>
        <span class="persona-role">Internal Audit &amp; GRC</span>
        <div class="threshold-badge">&#8805; 0.96</div>
        <p class="persona-desc">Conducts AI system audits under EU AI Act and NIST AI RMF. Needs defensible, citation-backed findings.</p>
        <span class="output-label">Output Format</span>
        <span class="output-value">Formal, risk-framed, citation-first findings</span>
      </div>
      <div class="persona-card">
        <h3>ML Engineer</h3>
        <span class="persona-role">AI System Development</span>
        <div class="threshold-badge">&#8805; 0.88</div>
        <p class="persona-desc">Builds AI systems that must comply with technical requirements. Needs regulations translated into engineering tasks.</p>
        <span class="output-label">Output Format</span>
        <span class="output-value">Technical, implementation-focused guidance</span>
      </div>
      <div class="persona-card">
        <h3>Legal Counsel</h3>
        <span class="persona-role">Regulatory Advisory</span>
        <div class="threshold-badge">&#8805; 0.96</div>
        <p class="persona-desc">Advises on AI regulatory obligations across jurisdictions. Needs article-by-article precision and cross-framework conflict analysis.</p>
        <span class="output-label">Output Format</span>
        <span class="output-value">Article-by-article precision, obligations distinguished from recommendations</span>
      </div>
    </div>
  </div>
</section>

<!-- ── ARCHITECTURE ── -->
<section id="architecture">
  <div class="section-wrap scroll-reveal">
    <p class="section-label">Architecture</p>
    <h2 class="section-heading" style="max-width:600px;">Three agents. No shared state.</h2>
    <p class="section-desc">Pipeline A handles background corpus ingestion. Pipeline B handles on-demand queries. They share no runtime state &#8212; this is a hard architectural constraint.</p>
    <div class="arch-grid">
      <div class="arch-card">
        <div class="arch-label">Agent I</div>
        <div class="arch-name">Horizon Ingestion</div>
        <p class="arch-desc">Corpus custodian. Ingests, chunks, and versions regulatory text with SHA-256. Runs independently on quarterly cadence. Never shares state with Pipeline B.</p>
      </div>
      <div class="arch-card">
        <div class="arch-label">Agent II</div>
        <div class="arch-name">Persona Synthesis</div>
        <p class="arch-desc">Config-driven query agent. Single agent, three persona configurations. Legal-BERT + Azure GPT-4o. Threshold applied per persona.</p>
      </div>
      <div class="arch-card">
        <div class="arch-label">Agent III</div>
        <div class="arch-name">Zero-Trust Critic</div>
        <p class="arch-desc">NLI verification at 0.88&#8211;0.96 threshold. Blocks unverified claims. Returns structured gap report when no claims pass. No exceptions.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── CORPUS ── -->
<section id="corpus">
  <div class="section-wrap scroll-reveal">
    <p class="section-label">Regulatory Corpus</p>
    <h2 class="section-heading">Primary sources only.</h2>
    <div class="corpus-grid">
      <div class="corpus-card">
        <h3>EU AI Act</h3>
        <span class="corpus-subtitle">Regulation (EU) 2024/1689</span>
        <p class="corpus-detail">278 chunks &#183; hierarchy-aware chunking at Article/Clause level</p>
      </div>
      <div class="corpus-card">
        <h3>NIST AI RMF 1.0</h3>
        <span class="corpus-subtitle">National Institute of Standards and Technology</span>
        <p class="corpus-detail">GOVERN &#183; MAP &#183; MEASURE &#183; MANAGE &#183; Full playbook coverage</p>
      </div>
      <div class="corpus-card">
        <h3>ISO 42001:2023</h3>
        <span class="corpus-subtitle">AI Management System Standard</span>
        <p class="corpus-detail">Clauses 4&#8211;10 &#183; Annex A controls &#183; Institutional access</p>
      </div>
    </div>
  </div>
</section>

<!-- ── FOOTER ── -->
<footer id="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <h4>ReguLens</h4>
      <p>Verifiable compliance intelligence for regulated industries.</p>
    </div>
    <div class="footer-col">
      <h5>Platform</h5>
      <a href="#architecture">Horizon Ingestion</a>
      <a href="#architecture">Persona Synthesis</a>
      <a href="#architecture">Zero-Trust Critic</a>
      <a href="#corpus">Multi-Framework Mapping</a>
    </div>
    <div class="footer-col">
      <h5>Resources</h5>
      <a href="#metrics">How It Works</a>
      <a href="#capabilities">Use Cases</a>
      <a href="#results">Evaluation Study</a>
      <a href="mailto:masters2k19@gmail.com">Contact</a>
    </div>
    <div class="footer-col">
      <p class="footer-legal">ReguLens v1 &#8212; Academic prototype. Outputs are AI-generated and require human review before use in any compliance decision.</p>
      <span class="footer-version">v1.0.0-academic</span>
    </div>
  </div>
</footer>

<script>
  // ── MATRIX RAIN ──
  (function initMatrix() {
    var alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789αβγδεζηθικλμνξοπρστυφχψωΣ∫√≠≈Π';
    var container = document.getElementById('matrix');
    var colWidth = 40;
    var cols = Math.floor(window.innerWidth / colWidth);

    for (var i = 0; i < cols; i++) {
      var col = document.createElement('div');
      col.className = 'matrix-col';
      col.style.left = (i * colWidth) + 'px';

      var charCount = Math.floor(Math.random() * 20) + 10;
      for (var j = 0; j < charCount; j++) {
        var span = document.createElement('span');
        span.textContent = alphabet[Math.floor(Math.random() * alphabet.length)];
        if (Math.random() < 0.15) {
          span.style.color = '#555';
        }
        col.appendChild(span);
      }

      var duration = 10 + Math.random() * 15;
      var delay = Math.random() * -20;
      col.style.animation = 'fall ' + duration + 's ' + delay + 's linear infinite';

      container.appendChild(col);
    }
  })();

  // ── NAV SCROLL ──
  var nav = document.getElementById('nav');
  window.addEventListener('scroll', function() {
    if (window.scrollY > window.innerHeight * 0.8) {
      nav.classList.add('scrolled');
    } else {
      nav.classList.remove('scrolled');
    }
  });

  // ── HAMBURGER ──
  var hamburger = document.getElementById('hamburger');
  var overlay = document.getElementById('mobile-overlay');
  var closeBtn = document.getElementById('close-overlay');

  hamburger.addEventListener('click', function() { overlay.classList.add('open'); });
  closeBtn.addEventListener('click', function() { overlay.classList.remove('open'); });
  document.querySelectorAll('.overlay-link').forEach(function(link) {
    link.addEventListener('click', function() { overlay.classList.remove('open'); });
  });

  // ── PERSONA TOGGLES ──
  var activePersona = 'lead_auditor';
  document.getElementById('persona-toggles').addEventListener('click', function(e) {
    var btn = e.target.closest('.persona-btn');
    if (!btn) return;
    document.querySelectorAll('.persona-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    activePersona = btn.dataset.persona;
  });

  // ── SCROLL REVEAL ──
  var revealObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.scroll-reveal').forEach(function(el) {
    revealObserver.observe(el);
  });

  // ── QUERY / API ──
  var coldStartTimer = null;
  var retryTimer = null;
  var stepTimers = [];

  function getPersonaThreshold(persona) {
    var map = { lead_auditor: '0.96', ml_engineer: '0.88', legal_counsel: '0.96' };
    return map[persona] || '0.96';
  }

  function verdictClass(v) {
    if (!v) return 'BLOCK';
    var upper = String(v).toUpperCase();
    if (upper === 'PASS' || upper === 'COMPLIANT' || upper === 'ENTAIL') return 'PASS';
    if (upper === 'FLAG' || upper === 'NEUTRAL' || upper === 'CONDITIONAL') return 'FLAG';
    return 'BLOCK';
  }

  function formatConf(c) {
    var n = parseFloat(c);
    return isNaN(n) ? String(c) : n.toFixed(3);
  }

  function showLoadingSteps() {
    var loadingEl = document.getElementById('loading-state');
    loadingEl.style.display = 'block';
    var steps = ['step-1', 'step-2', 'step-3'];
    steps.forEach(function(id) {
      var el = document.getElementById(id);
      el.classList.remove('active');
      el.querySelector('.loading-dot').classList.remove('pulsing');
    });
    steps.forEach(function(id, i) {
      var t = setTimeout(function() {
        var el = document.getElementById(id);
        el.classList.add('active');
        el.querySelector('.loading-dot').classList.add('pulsing');
      }, i * 1500);
      stepTimers.push(t);
    });
  }

  function hideLoadingSteps() {
    document.getElementById('loading-state').style.display = 'none';
    stepTimers.forEach(function(t) { clearTimeout(t); });
    stepTimers = [];
  }

  function clearTimers() {
    if (coldStartTimer) { clearTimeout(coldStartTimer); coldStartTimer = null; }
    if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function guessFramework(query) {
    var q = query.toLowerCase();
    if (q.indexOf('nist') !== -1 || q.indexOf('govern') !== -1 || q.indexOf('rmf') !== -1) return 'NIST AI RMF';
    if (q.indexOf('iso') !== -1 || q.indexOf('42001') !== -1) return 'ISO 42001';
    return 'EU AI Act';
  }

  function renderResults(data, query) {
    var persona = activePersona;
    var threshold = getPersonaThreshold(persona);
    var framework = guessFramework(query);

    document.getElementById('meta-query').textContent = query.length > 60 ? query.slice(0, 60) + '…' : query;
    document.getElementById('meta-persona').textContent = persona;
    document.getElementById('meta-threshold').textContent = threshold;
    document.getElementById('meta-framework').textContent = framework;

    var results = data.results || [];
    var tbody = document.getElementById('table-body');
    tbody.innerHTML = '';

    var pass = 0, flag = 0, block = 0;

    if (results.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" style="color:#444;text-align:center;padding:2rem;">No claims returned. Gap report: corpus does not cover this query at the configured threshold.</td></tr>';
    } else {
      results.forEach(function(item) {
        var conf = formatConf(item.similarity !== undefined ? item.similarity : (item.confidence !== undefined ? item.confidence : 0));
        var vc = verdictClass(item.verdict);
        if (vc === 'PASS') pass++;
        else if (vc === 'FLAG') flag++;
        else block++;

        var row = document.createElement('tr');
        var claimText = escapeHtml(item.content || item.claim || '—');
        var source = escapeHtml(item.article_ref || item.source || '—');
        var flagSub = vc === 'FLAG' ? '<span class="flag-sub">below ' + threshold + ' threshold</span>' : '';
        row.innerHTML =
          '<td>' + claimText + flagSub + '</td>' +
          '<td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">' + source + '</td>' +
          '<td style="font-family:var(--font-mono);font-size:0.85rem;">' + conf + '</td>' +
          '<td><span class="verdict-tag verdict-' + vc + '">' + vc + '</span></td>';
        tbody.appendChild(row);
      });
    }

    var overallEl = document.getElementById('footer-overall');
    if (pass === 0 && flag === 0 && block === 0) {
      overallEl.textContent = 'OVERALL: NO CLAIMS';
      overallEl.style.color = 'var(--text-muted)';
    } else if (block > 0 && flag > 0) {
      overallEl.textContent = 'OVERALL: VERIFIED WITH FLAGS';
      overallEl.style.color = 'var(--accent-orange)';
    } else if (block > 0) {
      overallEl.textContent = 'OVERALL: BLOCKED';
      overallEl.style.color = 'var(--accent-red)';
    } else if (flag > 0) {
      overallEl.textContent = 'OVERALL: VERIFIED WITH FLAGS';
      overallEl.style.color = 'var(--accent-orange)';
    } else {
      overallEl.textContent = 'OVERALL: VERIFIED';
      overallEl.style.color = 'var(--accent-green)';
    }

    document.getElementById('footer-counts').textContent = pass + ' PASS · ' + flag + ' FLAG · ' + block + ' BLOCK';

    if (data.audit_event_id) {
      document.getElementById('footer-audit').textContent = 'Audit ID: ' + data.audit_event_id;
    } else {
      document.getElementById('footer-audit').textContent = '';
    }

    document.getElementById('results').scrollIntoView({ behavior: 'smooth' });
  }

  function doFetch(query) {
    return fetch('https://regulens-api-bnlw.onrender.com/api/query', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: query, persona: activePersona })
    }).then(function(res) {
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.json();
    });
  }

  function runVerification() {
    var query = document.getElementById('query-input').value.trim();
    if (!query) return;

    var btn = document.getElementById('submit-btn');
    btn.disabled = true;
    document.getElementById('cold-start-msg').style.display = 'none';
    clearTimers();
    showLoadingSteps();

    coldStartTimer = setTimeout(function() {
      document.getElementById('cold-start-msg').style.display = 'block';
    }, 10000);

    function attempt() {
      doFetch(query).then(function(data) {
        clearTimers();
        hideLoadingSteps();
        document.getElementById('cold-start-msg').style.display = 'none';
        btn.disabled = false;
        renderResults(data, query);
      }).catch(function() {
        clearTimers();
        var msg = document.getElementById('cold-start-msg');
        msg.style.display = 'block';
        msg.textContent = '⚠ Waking API — Render free tier cold start. Retrying in 30s...';
        retryTimer = setTimeout(function() { attempt(); }, 30000);
      });
    }

    attempt();
  }

  // Enter to submit, Shift+Enter for newline
  document.getElementById('query-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      runVerification();
    }
  });
</script>
</body>
</html>

