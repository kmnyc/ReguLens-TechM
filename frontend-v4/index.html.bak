<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReguLens — Verifiable Compliance Intelligence</title>
  <style>
    :root {
      --bg-color: #050505;
      --card-bg: #0d0d0d;
      --border-color: #1a1a1a;
      --text-primary: #ffffff;
      --text-secondary: #888888;
      --text-muted: #444444;
      --accent-gold: #d4af37;
      --accent-green: #00ff66;
      --accent-orange: #ff9900;
      --accent-red: #ff3333;
      --font-mono: 'Courier New', Courier, monospace;
      --font-serif: 'Georgia', serif;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background-color: var(--bg-color);
      color: var(--text-primary);
      font-family: var(--font-sans);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }

    /* ── NAV ── */
    #nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 1000;
      padding: 2rem 4rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: background 0.3s ease;
    }
    #nav.scrolled { background: #0d0d0d; }

    .nav-logo {
      font-family: var(--font-sans);
      font-size: 1.5rem;
      font-weight: 500;
      color: var(--text-primary);
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }
    .nav-links a {
      font-size: 0.9rem;
      color: var(--text-secondary);
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text-primary); }

    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 4px;
    }
    .hamburger span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--text-primary);
      transition: 0.3s;
    }

    #mobile-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 999;
      background: var(--bg-color);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
    }
    #mobile-overlay.open { display: flex; }
    #mobile-overlay a {
      font-size: 1.5rem;
      color: var(--text-secondary);
    }
    #mobile-overlay a:hover { color: var(--text-primary); }
    #close-overlay {
      position: absolute;
      top: 2rem; right: 2rem;
      background: none;
      border: none;
      color: var(--text-primary);
      font-size: 1.5rem;
      cursor: pointer;
    }

    /* ── HERO ── */
    #hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      overflow: hidden;
    }

    #matrix {
      position: absolute;
      inset: 0;
      opacity: 0.15;
      pointer-events: none;
      overflow: hidden;
    }

    .matrix-col {
      position: absolute;
      top: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    @keyframes fall {
      from { transform: translateY(-10%); }
      to   { transform: translateY(110vh); }
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.3; }
    }

    .hero-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-tagline {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #888;
      margin-bottom: 1.5rem;
    }

    .hero-h1 {
      font-family: var(--font-serif);
      font-size: 3.5rem;
      font-weight: 400;
      max-width: 800px;
      margin-bottom: 1.5rem;
      line-height: 1.2;
    }

    .hero-sub {
      color: #888;
      max-width: 600px;
      margin-bottom: 3rem;
      font-size: 1.1rem;
    }

    .btn-outline {
      font-family: var(--font-mono);
      background: transparent;
      border: 1px solid #444;
      border-radius: 20px;
      padding: 0.8rem 2rem;
      color: var(--text-primary);
      cursor: pointer;
      font-size: 0.9rem;
      transition: border-color 0.2s, background 0.2s;
    }
    .btn-outline:hover {
      border-color: #fff;
      background: rgba(255, 255, 255, 0.05);
    }

    /* ── SECTION SHARED ── */
    .section-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 6rem 2rem;
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #888;
      margin-bottom: 1.5rem;
    }

    .section-heading {
      font-family: var(--font-serif);
      font-size: 2.8rem;
      font-weight: 400;
      margin-bottom: 2rem;
    }

    .section-desc {
      color: #888;
      max-width: 700px;
      margin-bottom: 4rem;
      font-size: 1rem;
    }

    /* ── SCROLL REVEAL ── */
    .scroll-reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .scroll-reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ── METRICS ── */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .metric-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      padding: 3rem 2rem;
      border-radius: 4px;
    }
    .metric-card h3 {
      font-family: var(--font-sans);
      font-size: 2.2rem;
      font-weight: 500;
      margin-bottom: 1rem;
    }
    .metric-card p {
      color: #888;
      font-size: 0.95rem;
    }
    .metric-gold h3 { color: var(--accent-gold); }

    /* ── QUERY ── */
    .query-section-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem 6rem 2rem;
    }

    .persona-toggles {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .persona-btn {
      font-family: var(--font-mono);
      background: transparent;
      border: 1px solid #444;
      border-radius: 4px;
      padding: 0.5rem 1.2rem;
      color: #888;
      cursor: pointer;
      font-size: 0.85rem;
      transition: border-color 0.2s, color 0.2s;
    }
    .persona-btn.active {
      border-color: #fff;
      color: #fff;
    }
    .persona-btn:hover:not(.active) {
      border-color: #666;
      color: #aaa;
    }

    .query-textarea {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      color: var(--text-primary);
      font-family: var(--font-sans);
      padding: 1.2rem;
      border-radius: 4px;
      width: 100%;
      min-height: 100px;
      resize: vertical;
      font-size: 0.95rem;
      display: block;
    }
    .query-textarea:focus {
      border-color: #444;
      outline: none;
    }
    .query-textarea::placeholder { color: var(--text-muted); }

    .submit-btn {
      font-family: var(--font-mono);
      background: transparent;
      border: 1px solid #888;
      color: var(--text-primary);
      padding: 0.8rem 2rem;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.9rem;
      margin-top: 1rem;
      transition: border-color 0.2s;
    }
    .submit-btn:hover:not(:disabled) { border-color: #fff; }
    .submit-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    #loading-state { display: none; margin-top: 1.5rem; }

    .loading-step {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: #444;
      margin-bottom: 0.5rem;
      transition: color 0.3s;
    }
    .loading-step.active { color: var(--accent-gold); }
    .loading-dot { display: inline-block; }
    .loading-dot.pulsing { animation: pulse 1s infinite; }

    #cold-start-msg {
      display: none;
      color: var(--accent-orange);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      margin-top: 1rem;
    }

    /* ── VERIFICATION TABLE ── */
    .results-section-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem 6rem 2rem;
    }

    .results-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 2.5rem;
    }

    .meta-bar {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 2rem;
      margin-bottom: 2rem;
      font-family: var(--font-mono);
      font-size: 0.8rem;
    }
    .meta-item label {
      display: block;
      color: #444;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 0.25rem;
    }
    .meta-item span { color: #888; }

    .verify-table {
      width: 100%;
      border-collapse: collapse;
    }
    .verify-table th {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: #444;
      text-transform: uppercase;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
      padding: 1rem 0.75rem;
      letter-spacing: 1px;
    }
    .verify-table td {
      padding: 1rem 0.75rem;
      border-bottom: 1px solid rgba(26,26,26,0.5);
      font-size: 0.9rem;
      vertical-align: top;
    }
    .verify-table tr:last-child td { border-bottom: none; }

    .verdict-tag {
      font-family: var(--font-mono);
      font-weight: bold;
      font-size: 0.8rem;
      padding: 0.2rem 0.6rem;
      border-radius: 3px;
      white-space: nowrap;
    }
    .verdict-PASS { background: rgba(0,255,102,0.1); color: #00ff66; }
    .verdict-FLAG { background: rgba(255,153,0,0.1); color: #ff9900; }
    .verdict-BLOCK { background: rgba(255,51,51,0.1); color: #ff3333; }

    .flag-sub {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--accent-red);
      margin-top: 0.3rem;
    }

    .table-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid var(--border-color);
      padding-top: 2rem;
      margin-top: 1rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .footer-overall {
      font-family: var(--font-mono);
      font-weight: bold;
      color: var(--accent-orange);
    }
    .footer-counts {
      font-family: var(--font-mono);
      color: #888;
    }
    .footer-audit {
      font-family: var(--font-mono);
      color: #444;
      font-size: 0.8rem;
      width: 100%;
    }

    /* ── CAPABILITIES ── */
    .capabilities-rows { border-top: 1px solid var(--border-color); }

    .cap-row {
      border-bottom: 1px solid var(--border-color);
      padding: 2rem 0;
    }
    .cap-row h3 {
      font-family: var(--font-serif);
      font-size: 1.3rem;
      margin-bottom: 0.5rem;
    }
    .cap-row p {
      color: #888;
      font-size: 0.95rem;
      max-width: 700px;
    }

    /* ── PERSONAS ── */
    .personas-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .persona-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      padding: 2.5rem;
      border-radius: 4px;
    }
    .persona-card h3 {
      font-family: var(--font-sans);
      font-size: 1.2rem;
      font-weight: 500;
      margin-bottom: 0.25rem;
    }
    .persona-role {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: #888;
      margin-bottom: 1.5rem;
      display: block;
    }
    .threshold-badge {
      font-family: var(--font-mono);
      color: var(--accent-gold);
      border: 1px solid rgba(212,175,55,0.3);
      background: rgba(212,175,55,0.05);
      padding: 0.2rem 0.6rem;
      border-radius: 3px;
      font-size: 0.85rem;
      display: inline-block;
      margin-bottom: 1rem;
    }
    .persona-desc {
      color: #888;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }
    .output-label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: #444;
      text-transform: uppercase;
      letter-spacing: 1px;
      display: block;
      margin-bottom: 0.25rem;
    }
    .output-value {
      font-size: 0.85rem;
      color: #888;
    }

    /* ── ARCHITECTURE ── */
    .arch-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .arch-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      padding: 2.5rem;
      border-radius: 4px;
    }
    .arch-label {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #444;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 0.5rem;
    }
    .arch-name {
      font-family: var(--font-serif);
      font-size: 1.3rem;
      margin-bottom: 1rem;
    }
    .arch-desc {
      color: #888;
      font-size: 0.9rem;
    }

    /* ── CORPUS ── */
    .corpus-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .corpus-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      padding: 2.5rem;
      border-radius: 4px;
    }
    .corpus-card h3 {
      font-family: var(--font-serif);
      font-size: 1.3rem;
      margin-bottom: 0.25rem;
    }
    .corpus-subtitle {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: #888;
      display: block;
      margin-bottom: 1rem;
    }
    .corpus-detail { color: #444; font-size: 0.9rem; }

    /* ── FOOTER ── */
    #footer {
      border-top: 1px solid var(--border-color);
      background: var(--bg-color);
      padding: 4rem 2rem;
    }
    .footer-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 3rem;
    }
    .footer-brand h4 {
      font-family: var(--font-sans);
      font-size: 1.2rem;
      font-weight: 500;
      margin-bottom: 1rem;
    }
    .footer-brand p {
      color: #888;
      font-size: 0.9rem;
    }
    .footer-col h5 {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #444;
      margin-bottom: 1rem;
    }
    .footer-col a {
      color: #888;
      font-size: 0.9rem;
      display: block;
      margin-bottom: 0.5rem;
      transition: color 0.2s;
    }
    .footer-col a:hover { color: var(--text-primary); }
    .footer-legal { color: #444; font-size: 0.85rem; margin-bottom: 1rem; }
    .footer-version {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #333;
    }

    /* ── MOBILE ── */
    @media (max-width: 768px) {
      #nav { padding: 1.5rem 2rem; }
      .nav-links { display: none; }
      .hamburger { display: flex; }

      .hero-h1 { font-size: 2.2rem; }

      .section-wrap { padding: 4rem 1.5rem; }
      .query-section-wrap { padding: 0 1.5rem 4rem 1.5rem; }
      .results-section-wrap { padding: 0 1.5rem 4rem 1.5rem; }

      .metrics-grid { grid-template-columns: 1fr; }
      .personas-grid { grid-template-columns: 1fr; }
      .arch-grid { grid-template-columns: 1fr; }
      .corpus-grid { grid-template-columns: 1fr; }

      .meta-bar { grid-template-columns: repeat(2, 1fr); }

      .footer-inner { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 480px) {
      .footer-inner { grid-template-columns: 1fr; }
      .meta-bar { grid-template-columns: 1fr; }
      .table-footer { flex-direction: column; align-items: flex-start; }
    }

    /* ── MIC BUTTON ── */
    #mic-btn:hover { border-color: var(--text-secondary); color: #fff; }
    #mic-btn.rec { border-color: var(--accent-red); color: var(--accent-red); animation: micPulse 1s infinite; }
    @keyframes micPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(255,51,51,0.4); }
      50% { box-shadow: 0 0 0 6px rgba(255,51,51,0); }
    }
    #wave-row { display:none; align-items:center; gap:0.75rem;
                font-family:var(--font-mono); font-size:0.8rem;
                color:var(--text-secondary); margin-top:0.75rem; }
    #wave-row.show { display:flex; }
    .bars { display:flex; gap:3px; align-items:center; }
    .bar { width:3px; height:16px; background:var(--accent-gold);
           border-radius:2px; animation:barBounce 0.8s infinite ease-in-out; }
    .bar:nth-child(2) { animation-delay:0.1s; }
    .bar:nth-child(3) { animation-delay:0.2s; }
    .bar:nth-child(4) { animation-delay:0.3s; }
    .bar:nth-child(5) { animation-delay:0.4s; }
    .bar:nth-child(6) { animation-delay:0.5s; }
    .bar:nth-child(7) { animation-delay:0.6s; }
    @keyframes barBounce {
      0%, 100% { transform: scaleY(0.4); }
      50% { transform: scaleY(1); }
    }

    /* ── SAMPLE CHIPS ── */
    .sample-chip {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-secondary);
      padding: 0.3rem 0.75rem;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .sample-chip:hover { border-color: var(--text-secondary); color: var(--text-primary); }

    /* ── FILE ATTACH ── */
    #file-label:hover { border-color: var(--text-secondary); color: #fff; }
    .file-tag {
      display:inline-flex; align-items:center; gap:0.4rem;
      font-family:var(--font-mono); font-size:0.75rem;
      color:var(--accent-gold); border:1px solid rgba(212,175,55,0.3);
      background:rgba(212,175,55,0.05); border-radius:4px; padding:0.3rem 0.6rem;
    }
    .file-clear { cursor:pointer; color:var(--text-muted); margin-left:0.25rem; }
    .file-clear:hover { color:var(--accent-red); }

    /* ── AUDIT LOG ── */
    @keyframes auditRise {
      from { opacity:0; transform:translateY(-8px); }
      to { opacity:1; transform:translateY(0); }
    }
  </style>
</head>
<body>

<!-- ── MOBILE OVERLAY ── -->
<div id="mobile-overlay">
  <button id="close-overlay" aria-label="Close menu">&#x2715;</button>
  <a href="#metrics" class="overlay-link">How It Works</a>
  <a href="#capabilities" class="overlay-link">Use Cases</a>
  <a href="#architecture" class="overlay-link">Architecture</a>
  <a href="#benchmark" class="overlay-link">Benchmark</a>
  <a href="#audit-log" class="overlay-link">Audit Log</a>
</div>

<!-- ── NAV ── -->
<nav id="nav">
  <div class="nav-logo">ReguLens</div>
  <ul class="nav-links">
    <li><a href="#metrics">How It Works</a></li>
    <li><a href="#capabilities">Use Cases</a></li>
    <li><a href="#architecture">Architecture</a></li>
    <li><a href="#benchmark">Benchmark</a></li>
    <li><a href="#audit-log">Audit Log</a></li>
  </ul>
  <button class="hamburger" id="hamburger" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- ── HERO ── -->
<section id="hero">
  <div id="matrix" aria-hidden="true"></div>
  <div class="hero-content">
    <p class="hero-tagline">Verifiable Compliance Intelligence</p>
    <h1 class="hero-h1">From regulatory text to verified claims.</h1>
    <p class="hero-sub">ReguLens decomposes compliance questions into atomic claims, verifies each against a frozen regulatory corpus, and returns structured intelligence with NLI confidence scores.</p>
    <button class="btn-outline" onclick="document.getElementById('architecture').scrollIntoView({behavior:'smooth'})">View Architecture</button>
  </div>
</section>

<!-- ── METRICS ── -->
<section id="metrics">
  <div class="section-wrap scroll-reveal">
    <p class="section-label">The Numbers</p>
    <div class="metrics-grid">
      <div class="metric-card metric-gold">
        <h3>278</h3>
        <p>Regulatory chunks indexed across EU AI Act, NIST AI RMF 1.0, and ISO 42001</p>
      </div>
      <div class="metric-card">
        <h3>3</h3>
        <p>Agents in the verification pipeline: Horizon Ingestion, Persona Synthesis, Zero-Trust Critic</p>
      </div>
      <div class="metric-card">
        <h3>0.96</h3>
        <p>NLI confidence threshold for Lead Auditor and Legal Counsel personas. ML Engineer threshold: 0.88</p>
      </div>
    </div>
  </div>
</section>

<!-- ── LIVE QUERY ── -->
<section id="query">
  <div class="query-section-wrap scroll-reveal">
    <p class="section-label">Live Verification</p>
    <h2 class="section-heading">Query the regulatory corpus.</h2>

    <div class="persona-toggles" id="persona-toggles">
      <button class="persona-btn active" data-persona="lead_auditor">Lead Auditor</button>
      <button class="persona-btn" data-persona="ml_engineer">ML Engineer</button>
      <button class="persona-btn" data-persona="legal_counsel">Legal Counsel</button>
    </div>

    <div id="sample-queries" style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:1rem;">
      <button class="sample-chip" onclick="setSampleQuery('What does EU AI Act Article 9 require for high-risk AI systems?')">Art. 9 high-risk</button>
      <button class="sample-chip" onclick="setSampleQuery('What are the prohibited AI practices under EU AI Act Article 5?')">Art. 5 prohibitions</button>
      <button class="sample-chip" onclick="setSampleQuery('How does NIST AI RMF GOVERN function apply to AI risk management?')">NIST GOVERN</button>
      <button class="sample-chip" onclick="setSampleQuery('What human oversight controls does ISO 42001 Clause 6 require?')">ISO 42001 Cl. 6</button>
      <button class="sample-chip" onclick="setSampleQuery('What transparency obligations apply under EU AI Act Articles 13 and 14?')">Transparency 13–14</button>
    </div>

    <div style="position:relative;">
      <textarea
        class="query-textarea"
        id="query-input"
        placeholder="Enter your compliance question..."
      ></textarea>
      <button id="mic-btn" title="Voice input" onclick="toggleMic()"
        style="position:absolute; top:0.75rem; right:0.75rem;
               background:transparent; border:1px solid var(--border-color);
               color:var(--text-secondary); border-radius:4px;
               width:32px; height:32px; cursor:pointer; display:flex;
               align-items:center; justify-content:center;
               transition: all 0.2s;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             style="width:14px;height:14px">
          <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
          <line x1="12" y1="19" x2="12" y2="23"/>
          <line x1="8" y1="23" x2="16" y2="23"/>
        </svg>
      </button>
    </div>

    <div id="wave-row">
      <div class="bars">
        <div class="bar"></div><div class="bar"></div><div class="bar"></div>
        <div class="bar"></div><div class="bar"></div><div class="bar"></div>
        <div class="bar"></div>
      </div>
      Listening…
    </div>

    <div style="display:flex; align-items:center; gap:1rem; margin-top:1rem; flex-wrap:wrap;">
      <label id="file-label" for="file-input" style="
        display:inline-flex; align-items:center; gap:0.4rem;
        font-family:var(--font-mono); font-size:0.8rem;
        color:var(--text-secondary); cursor:pointer;
        border:1px solid var(--border-color); border-radius:4px;
        padding:0.5rem 0.9rem; transition:all 0.2s;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             style="width:13px;height:13px;flex-shrink:0">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        Attach document
      </label>
      <input type="file" id="file-input" accept=".pdf,.txt,.docx" style="display:none" onchange="handleFile(this)">
      <button class="submit-btn" id="submit-btn" onclick="runVerification()" style="margin-top:0;">Run Verification</button>
    </div>

    <div id="loading-state">
      <div class="loading-step" id="step-1"><span class="loading-dot">&#9679;</span> Agent I &#8212; Horizon Ingestion: retrieving corpus chunks...</div>
      <div class="loading-step" id="step-2"><span class="loading-dot">&#9679;</span> Agent II &#8212; Persona Synthesis: synthesizing response...</div>
      <div class="loading-step" id="step-3"><span class="loading-dot">&#9679;</span> Agent III &#8212; Zero-Trust Critic: verifying claims...</div>
    </div>
    <div id="cold-start-msg">&#9888; Waking API &#8212; Render free tier cold start. Retrying in 30s...</div>
  </div>
</section>

<!-- ── VERIFICATION TABLE ── -->
<section id="results">
  <div class="results-section-wrap scroll-reveal">
    <p class="section-label">Verification Output</p>
    <h2 class="section-heading">Every claim traced to source.</h2>

    <div class="results-card">
      <div class="meta-bar" id="meta-bar">
        <div class="meta-item"><label>Query</label><span id="meta-query">Article 9 risk management requirements</span></div>
        <div class="meta-item"><label>Persona</label><span id="meta-persona">lead_auditor</span></div>
        <div class="meta-item"><label>Threshold</label><span id="meta-threshold">0.96</span></div>
        <div class="meta-item"><label>Framework</label><span id="meta-framework">EU AI Act</span></div>
      </div>

      <div style="overflow-x:auto;">
        <table class="verify-table" id="verify-table">
          <thead>
            <tr>
              <th>Claim</th>
              <th>Source</th>
              <th>Confidence</th>
              <th>Verdict</th>
            </tr>
          </thead>
          <tbody id="table-body">
            <tr>
              <td>Risk management system must be established and maintained</td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">Article 9 &#167;1</td>
              <td style="font-family:var(--font-mono);font-size:0.85rem;">1.000</td>
              <td><span class="verdict-tag verdict-PASS">PASS</span></td>
            </tr>
            <tr>
              <td>System must identify known and foreseeable risks</td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">Article 9 &#167;2(a)</td>
              <td style="font-family:var(--font-mono);font-size:0.85rem;">0.987</td>
              <td><span class="verdict-tag verdict-PASS">PASS</span></td>
            </tr>
            <tr>
              <td>
                Residual risks must be communicated to users
                <span class="flag-sub">below 0.96 threshold</span>
              </td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">Article 9 &#167;4</td>
              <td style="font-family:var(--font-mono);font-size:0.85rem;">0.923</td>
              <td><span class="verdict-tag verdict-FLAG">FLAG</span></td>
            </tr>
            <tr>
              <td>Risk management applies to the full AI lifecycle</td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">Article 9 &#167;1</td>
              <td style="font-family:var(--font-mono);font-size:0.85rem;">0.971</td>
              <td><span class="verdict-tag verdict-PASS">PASS</span></td>
            </tr>
            <tr>
              <td>Annual third-party audit required for all systems</td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">Article 9</td>
              <td style="font-family:var(--font-mono);font-size:0.85rem;">0.410</td>
              <td><span class="verdict-tag verdict-BLOCK">BLOCK</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="table-footer">
        <span class="footer-overall" id="footer-overall">OVERALL: VERIFIED WITH FLAGS</span>
        <span class="footer-counts" id="footer-counts">3 PASS &#183; 1 FLAG &#183; 1 BLOCK</span>
        <span class="footer-audit" id="footer-audit"></span>
      </div>
    </div>
  </div>
</section>

<!-- ── AUDIT LOG ── -->
<section id="audit-log" style="max-width:1200px; margin:0 auto; padding:0 2rem 6rem;">
  <span style="font-family:var(--font-mono); font-size:0.8rem; text-transform:uppercase; color:var(--text-secondary); letter-spacing:2px; margin-bottom:2rem; display:block;">AUDIT TRAIL</span>
  <h2 style="font-family:var(--font-serif); font-size:2.8rem; font-weight:400; margin-bottom:1rem;">Every query logged.</h2>
  <p style="color:var(--text-secondary); margin-bottom:3rem; max-width:600px;">SHA-256 hash chain. Tamper-evident. Every verification event recorded.</p>
  <div style="background:var(--card-bg); border:1px solid var(--border-color); border-radius:6px; padding:2rem; overflow-x:auto;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; padding-bottom:1.5rem; border-bottom:1px solid var(--border-color);">
      <span style="font-family:var(--font-mono); font-size:0.8rem; color:var(--text-secondary);">AUDIT LOG</span>
      <span id="chain-status" style="font-family:var(--font-mono); font-size:0.75rem; color:var(--accent-green); display:flex; align-items:center; gap:0.4rem;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        SHA-256 chain valid
      </span>
    </div>
    <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
      <thead>
        <tr>
          <th style="font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); text-align:left; padding:0.75rem 0; border-bottom:1px solid var(--border-color); text-transform:uppercase;">Timestamp</th>
          <th style="font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); text-align:left; padding:0.75rem 0; border-bottom:1px solid var(--border-color); text-transform:uppercase;">Query</th>
          <th style="font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); text-align:left; padding:0.75rem 0; border-bottom:1px solid var(--border-color); text-transform:uppercase;">Persona</th>
          <th style="font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); text-align:left; padding:0.75rem 0; border-bottom:1px solid var(--border-color); text-transform:uppercase;">Verdict</th>
          <th style="font-family:var(--font-mono); font-size:0.75rem; color:var(--text-muted); text-align:left; padding:0.75rem 0; border-bottom:1px solid var(--border-color); text-transform:uppercase;">Hash</th>
        </tr>
      </thead>
      <tbody id="audit-body">
        <tr>
          <td style="padding:1rem 0; border-bottom:1px solid #111; color:var(--text-muted); font-family:var(--font-mono); font-size:0.8rem;">2026-05-24 11:12</td>
          <td style="padding:1rem 0; border-bottom:1px solid #111; max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">EU AI Act Article 9 — high-risk systems</td>
          <td style="padding:1rem 0; border-bottom:1px solid #111;"><span style="font-family:var(--font-mono); font-size:0.75rem; font-weight:bold; background:rgba(100,120,255,0.1); color:#8899ff; padding:0.2rem 0.5rem; border-radius:3px;">lead_auditor</span></td>
          <td style="padding:1rem 0; border-bottom:1px solid #111;"><span style="font-family:var(--font-mono); font-size:0.75rem; font-weight:bold; background:rgba(0,255,102,0.1); color:var(--accent-green); padding:0.2rem 0.5rem; border-radius:3px;">PASS</span></td>
          <td style="padding:1rem 0; border-bottom:1px solid #111; font-family:var(--font-mono); font-size:0.8rem; color:var(--text-muted);">a3f9b2…e8d4</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<!-- ── CAPABILITIES ── -->
<section id="capabilities">
  <div class="section-wrap scroll-reveal">
    <p class="section-label">Capabilities</p>
    <h2 class="section-heading" style="max-width:600px;">Built for regulated industries.</h2>
    <div class="capabilities-rows">
      <div class="cap-row">
        <h3>Tri-Agent Verification Pipeline</h3>
        <p>Three specialized agents handle ingestion, synthesis, and zero-trust verification independently. No shared runtime state.</p>
      </div>
      <div class="cap-row">
        <h3>Persona-Aware Thresholds</h3>
        <p>Lead Auditor and Legal Counsel operate at 0.96 NLI confidence. ML Engineer at 0.88. Asymmetric by design.</p>
      </div>
      <div class="cap-row">
        <h3>Frozen Corpus Architecture</h3>
        <p>Regulatory text is ingested once, versioned with SHA-256, and never modified. Every claim traces to an immutable source.</p>
      </div>
      <div class="cap-row">
        <h3>Gap Report Generation</h3>
        <p>When no claims pass the verification threshold, ReguLens generates a structured gap report identifying what the corpus does not cover.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── PERSONAS ── -->
<section id="personas">
  <div class="section-wrap scroll-reveal">
    <p class="section-label">Who It's For</p>
    <h2 class="section-heading">Three personas. One platform.</h2>
    <div class="personas-grid">
      <div class="persona-card">
        <h3>Lead Auditor</h3>
        <span class="persona-role">Internal Audit &amp; GRC</span>
        <div class="threshold-badge">&#8805; 0.96</div>
        <p class="persona-desc">Conducts AI system audits under EU AI Act and NIST AI RMF. Needs defensible, citation-backed findings.</p>
        <span class="output-label">Output Format</span>
        <span class="output-value">Formal, risk-framed, citation-first findings</span>
      </div>
      <div class="persona-card">
        <h3>ML Engineer</h3>
        <span class="persona-role">AI System Development</span>
        <div class="threshold-badge">&#8805; 0.88</div>
        <p class="persona-desc">Builds AI systems that must comply with technical requirements. Needs regulations translated into engineering tasks.</p>
        <span class="output-label">Output Format</span>
        <span class="output-value">Technical, implementation-focused guidance</span>
      </div>
      <div class="persona-card">
        <h3>Legal Counsel</h3>
        <span class="persona-role">Regulatory Advisory</span>
        <div class="threshold-badge">&#8805; 0.96</div>
        <p class="persona-desc">Advises on AI regulatory obligations across jurisdictions. Needs article-by-article precision and cross-framework conflict analysis.</p>
        <span class="output-label">Output Format</span>
        <span class="output-value">Article-by-article precision, obligations distinguished from recommendations</span>
      </div>
    </div>
  </div>
</section>

<!-- ── ARCHITECTURE ── -->
<section id="architecture">
  <div class="section-wrap scroll-reveal">
    <p class="section-label">Architecture</p>
    <h2 class="section-heading" style="max-width:600px;">Three agents. No shared state.</h2>
    <p class="section-desc">Pipeline A handles background corpus ingestion. Pipeline B handles on-demand queries. They share no runtime state &#8212; this is a hard architectural constraint.</p>
    <div style="display:flex; gap:1rem; margin-bottom:3rem; flex-wrap:wrap;">
      <a href="#architecture" style="font-family:var(--font-mono); font-size:0.8rem; color:var(--text-secondary); text-decoration:none; border:1px solid var(--border-color); padding:0.4rem 1rem; border-radius:20px; transition:all 0.2s;" onmouseover="this.style.borderColor='#888'" onmouseout="this.style.borderColor='var(--border-color)'">Architecture</a>
      <a href="#personas" style="font-family:var(--font-mono); font-size:0.8rem; color:var(--text-secondary); text-decoration:none; border:1px solid var(--border-color); padding:0.4rem 1rem; border-radius:20px; transition:all 0.2s;" onmouseover="this.style.borderColor='#888'" onmouseout="this.style.borderColor='var(--border-color)'">Personas</a>
      <a href="#corpus" style="font-family:var(--font-mono); font-size:0.8rem; color:var(--text-secondary); text-decoration:none; border:1px solid var(--border-color); padding:0.4rem 1rem; border-radius:20px; transition:all 0.2s;" onmouseover="this.style.borderColor='#888'" onmouseout="this.style.borderColor='var(--border-color)'">Corpus</a>
      <a href="#benchmark" style="font-family:var(--font-mono); font-size:0.8rem; color:var(--text-secondary); text-decoration:none; border:1px solid var(--border-color); padding:0.4rem 1rem; border-radius:20px; transition:all 0.2s;" onmouseover="this.style.borderColor='#888'" onmouseout="this.style.borderColor='var(--border-color)'">Benchmark</a>
      <a href="#audit-log" style="font-family:var(--font-mono); font-size:0.8rem; color:var(--text-secondary); text-decoration:none; border:1px solid var(--border-color); padding:0.4rem 1rem; border-radius:20px; transition:all 0.2s;" onmouseover="this.style.borderColor='#888'" onmouseout="this.style.borderColor='var(--border-color)'">Audit Log</a>
    </div>
    <div class="arch-grid">
      <div class="arch-card">
        <div class="arch-label">Agent I</div>
        <div class="arch-name">Horizon Ingestion</div>
        <p class="arch-desc">Corpus custodian. Ingests, chunks, and versions regulatory text with SHA-256. Runs independently on quarterly cadence. Never shares state with Pipeline B.</p>
      </div>
      <div class="arch-card">
        <div class="arch-label">Agent II</div>
        <div class="arch-name">Persona Synthesis</div>
        <p class="arch-desc">Config-driven query agent. Single agent, three persona configurations. Legal-BERT + Azure GPT-4o. Threshold applied per persona.</p>
      </div>
      <div class="arch-card">
        <div class="arch-label">Agent III</div>
        <div class="arch-name">Zero-Trust Critic</div>
        <p class="arch-desc">NLI verification at 0.88&#8211;0.96 threshold. Blocks unverified claims. Returns structured gap report when no claims pass. No exceptions.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── CORPUS ── -->
<section id="corpus">
  <div class="section-wrap scroll-reveal">
    <p class="section-label">Regulatory Corpus</p>
    <h2 class="section-heading">Primary sources only.</h2>
    <div class="corpus-grid">
      <div class="corpus-card">
        <h3>EU AI Act</h3>
        <span class="corpus-subtitle">Regulation (EU) 2024/1689</span>
        <p class="corpus-detail">278 chunks &#183; hierarchy-aware chunking at Article/Clause level</p>
      </div>
      <div class="corpus-card">
        <h3>NIST AI RMF 1.0</h3>
        <span class="corpus-subtitle">National Institute of Standards and Technology</span>
        <p class="corpus-detail">GOVERN &#183; MAP &#183; MEASURE &#183; MANAGE &#183; Full playbook coverage</p>
      </div>
      <div class="corpus-card">
        <h3>ISO 42001:2023</h3>
        <span class="corpus-subtitle">AI Management System Standard</span>
        <p class="corpus-detail">Clauses 4&#8211;10 &#183; Annex A controls &#183; Institutional access</p>
      </div>
    </div>
  </div>
</section>

<!-- ── BENCHMARK ── -->
<section id="benchmark" style="max-width:1200px; margin:0 auto; padding:0 2rem 6rem;">
  <span style="font-family:var(--font-mono); font-size:0.8rem; text-transform:uppercase; color:var(--text-secondary); letter-spacing:2px; margin-bottom:2rem; display:block;">EVALUATION</span>
  <h2 style="font-family:var(--font-serif); font-size:2.8rem; font-weight:400; margin-bottom:1rem; max-width:600px;">Benchmark results.</h2>
  <p style="color:var(--text-secondary); margin-bottom:3rem; max-width:600px;">30 benchmark tasks across simple, moderate, and complex tiers. Evaluated against human-annotated gold standard answers.</p>
  <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; margin-bottom:3rem;">
    <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:2rem 1.5rem; border-radius:4px;">
      <div style="font-family:var(--font-sans); font-size:2rem; font-weight:500; color:var(--accent-green); margin-bottom:0.5rem;">30</div>
      <div style="color:var(--text-secondary); font-size:0.85rem;">Benchmark tasks completed</div>
    </div>
    <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:2rem 1.5rem; border-radius:4px;">
      <div style="font-family:var(--font-sans); font-size:2rem; font-weight:500; color:var(--accent-gold); margin-bottom:0.5rem;">0%</div>
      <div style="color:var(--text-secondary); font-size:0.85rem;">Error rate across all tasks</div>
    </div>
    <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:2rem 1.5rem; border-radius:4px;">
      <div style="font-family:var(--font-sans); font-size:2rem; font-weight:500; margin-bottom:0.5rem;">3.1s</div>
      <div style="color:var(--text-secondary); font-size:0.85rem;">Average response time</div>
    </div>
    <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:2rem 1.5rem; border-radius:4px;">
      <div style="font-family:var(--font-sans); font-size:2rem; font-weight:500; color:var(--accent-orange); margin-bottom:0.5rem;">0.84</div>
      <div style="color:var(--text-secondary); font-size:0.85rem;">Average NLI confidence score</div>
    </div>
  </div>
  <div style="background:var(--card-bg); border:1px solid var(--border-color); padding:2rem; border-radius:4px;">
    <div style="font-family:var(--font-mono); font-size:0.8rem; color:var(--text-muted); text-transform:uppercase; margin-bottom:1.5rem;">VERDICT DISTRIBUTION — 150 CLAIMS ACROSS 30 TASKS</div>
    <div style="display:flex; gap:1rem; margin-bottom:1.5rem; flex-wrap:wrap;">
      <div style="display:flex; align-items:center; gap:0.5rem;"><div style="width:10px;height:10px;border-radius:2px;background:var(--accent-green);"></div><span style="font-family:var(--font-mono);font-size:0.8rem;color:var(--text-secondary);">PASS — 47 (31%)</span></div>
      <div style="display:flex; align-items:center; gap:0.5rem;"><div style="width:10px;height:10px;border-radius:2px;background:var(--accent-orange);"></div><span style="font-family:var(--font-mono);font-size:0.8rem;color:var(--text-secondary);">FLAG — 86 (57%)</span></div>
      <div style="display:flex; align-items:center; gap:0.5rem;"><div style="width:10px;height:10px;border-radius:2px;background:var(--accent-red);"></div><span style="font-family:var(--font-mono);font-size:0.8rem;color:var(--text-secondary);">BLOCK — 17 (11%)</span></div>
    </div>
    <div style="height:12px; border-radius:6px; overflow:hidden; display:flex; width:100%;">
      <div style="width:31%; background:var(--accent-green); transition:width 1s ease;"></div>
      <div style="width:57%; background:var(--accent-orange);"></div>
      <div style="width:11%; background:var(--accent-red);"></div>
    </div>
    <div style="margin-top:1.5rem; padding-top:1.5rem; border-top:1px solid var(--border-color); font-family:var(--font-mono); font-size:0.8rem; color:var(--text-muted);">
      High FLAG rate (57%) reflects persona-aware threshold enforcement — the Zero-Trust Critic applies 0.96 threshold for Lead Auditor and Legal Counsel. Annotation and NLI head-to-head comparison in progress.
    </div>
  </div>
</section>

<!-- ── FOOTER ── -->
<footer id="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <h4>ReguLens</h4>
      <p>Verifiable compliance intelligence for regulated industries.</p>
    </div>
    <div class="footer-col">
      <h5>Platform</h5>
      <a href="#architecture">Horizon Ingestion</a>
      <a href="#architecture">Persona Synthesis</a>
      <a href="#architecture">Zero-Trust Critic</a>
      <a href="#corpus">Multi-Framework Mapping</a>
    </div>
    <div class="footer-col">
      <h5>Resources</h5>
      <a href="#metrics">How It Works</a>
      <a href="#capabilities">Use Cases</a>
      <a href="#results">Evaluation Study</a>
      <a href="mailto:masters2k19@gmail.com">Contact</a>
    </div>
    <div class="footer-col">
      <p class="footer-legal">ReguLens v1 &#8212; Academic prototype. Outputs are AI-generated and require human review before use in any compliance decision.</p>
      <span class="footer-version">v1.0.0-academic</span>
    </div>
  </div>
</footer>

<script>
  // ── MATRIX RAIN ──
  (function initMatrix() {
    var alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789αβγδεζηθικλμνξοπρστυφχψωΣ∫√≠≈Π';
    var container = document.getElementById('matrix');
    var colWidth = 40;
    var cols = Math.floor(window.innerWidth / colWidth);

    for (var i = 0; i < cols; i++) {
      var col = document.createElement('div');
      col.className = 'matrix-col';
      col.style.left = (i * colWidth) + 'px';

      var charCount = Math.floor(Math.random() * 20) + 10;
      for (var j = 0; j < charCount; j++) {
        var span = document.createElement('span');
        span.textContent = alphabet[Math.floor(Math.random() * alphabet.length)];
        if (Math.random() < 0.15) {
          span.style.color = '#555';
        }
        col.appendChild(span);
      }

      var duration = 10 + Math.random() * 15;
      var delay = Math.random() * -20;
      col.style.animation = 'fall ' + duration + 's ' + delay + 's linear infinite';

      container.appendChild(col);
    }
  })();

  // ── NAV SCROLL ──
  var nav = document.getElementById('nav');
  window.addEventListener('scroll', function() {
    if (window.scrollY > window.innerHeight * 0.8) {
      nav.classList.add('scrolled');
    } else {
      nav.classList.remove('scrolled');
    }
  });

  // ── HAMBURGER ──
  var hamburger = document.getElementById('hamburger');
  var overlay = document.getElementById('mobile-overlay');
  var closeBtn = document.getElementById('close-overlay');

  hamburger.addEventListener('click', function() { overlay.classList.add('open'); });
  closeBtn.addEventListener('click', function() { overlay.classList.remove('open'); });
  document.querySelectorAll('.overlay-link').forEach(function(link) {
    link.addEventListener('click', function() { overlay.classList.remove('open'); });
  });

  // ── PERSONA TOGGLES ──
  var activePersona = 'lead_auditor';
  document.getElementById('persona-toggles').addEventListener('click', function(e) {
    var btn = e.target.closest('.persona-btn');
    if (!btn) return;
    document.querySelectorAll('.persona-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    activePersona = btn.dataset.persona;
  });

  // ── SCROLL REVEAL ──
  var revealObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.scroll-reveal').forEach(function(el) {
    revealObserver.observe(el);
  });

  // ── QUERY / API ──
  var coldStartTimer = null;
  var retryTimer = null;
  var stepTimers = [];

  function getPersonaThreshold(persona) {
    var map = { lead_auditor: '0.96', ml_engineer: '0.88', legal_counsel: '0.96' };
    return map[persona] || '0.96';
  }

  function verdictClass(v) {
    if (!v) return 'BLOCK';
    var upper = String(v).toUpperCase();
    if (upper === 'PASS' || upper === 'COMPLIANT' || upper === 'ENTAIL') return 'PASS';
    if (upper === 'FLAG' || upper === 'NEUTRAL' || upper === 'CONDITIONAL') return 'FLAG';
    return 'BLOCK';
  }

  function formatConf(c) {
    var n = parseFloat(c);
    return isNaN(n) ? String(c) : n.toFixed(3);
  }

  function showLoadingSteps() {
    var loadingEl = document.getElementById('loading-state');
    loadingEl.style.display = 'block';
    var steps = ['step-1', 'step-2', 'step-3'];
    steps.forEach(function(id) {
      var el = document.getElementById(id);
      el.classList.remove('active');
      el.querySelector('.loading-dot').classList.remove('pulsing');
    });
    steps.forEach(function(id, i) {
      var t = setTimeout(function() {
        var el = document.getElementById(id);
        el.classList.add('active');
        el.querySelector('.loading-dot').classList.add('pulsing');
      }, i * 1500);
      stepTimers.push(t);
    });
  }

  function hideLoadingSteps() {
    document.getElementById('loading-state').style.display = 'none';
    stepTimers.forEach(function(t) { clearTimeout(t); });
    stepTimers = [];
  }

  function clearTimers() {
    if (coldStartTimer) { clearTimeout(coldStartTimer); coldStartTimer = null; }
    if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function guessFramework(query) {
    var q = query.toLowerCase();
    if (q.indexOf('nist') !== -1 || q.indexOf('govern') !== -1 || q.indexOf('rmf') !== -1) return 'NIST AI RMF';
    if (q.indexOf('iso') !== -1 || q.indexOf('42001') !== -1) return 'ISO 42001';
    return 'EU AI Act';
  }

  function renderResults(data, query) {
    var persona = activePersona;
    var threshold = getPersonaThreshold(persona);
    var framework = guessFramework(query);

    document.getElementById('meta-query').textContent = query.length > 60 ? query.slice(0, 60) + '…' : query;
    document.getElementById('meta-persona').textContent = persona;
    document.getElementById('meta-threshold').textContent = threshold;
    document.getElementById('meta-framework').textContent = framework;

    var results = data.results || [];
    var tbody = document.getElementById('table-body');
    tbody.innerHTML = '';

    var pass = 0, flag = 0, block = 0;

    if (results.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" style="color:#444;text-align:center;padding:2rem;">No claims returned. Gap report: corpus does not cover this query at the configured threshold.</td></tr>';
    } else {
      results.forEach(function(item) {
        var conf = formatConf(item.similarity !== undefined ? item.similarity : (item.confidence !== undefined ? item.confidence : 0));
        var vc = verdictClass(item.verdict);
        if (vc === 'PASS') pass++;
        else if (vc === 'FLAG') flag++;
        else block++;

        var row = document.createElement('tr');
        var claimText = escapeHtml(item.content || item.claim || '—');
        var source = escapeHtml(item.article_ref || item.source || '—');
        var flagSub = vc === 'FLAG' ? '<span class="flag-sub">below ' + threshold + ' threshold</span>' : '';
        row.innerHTML =
          '<td>' + claimText + flagSub + '</td>' +
          '<td style="white-space:nowrap;font-family:var(--font-mono);font-size:0.8rem;color:#888;">' + source + '</td>' +
          '<td style="font-family:var(--font-mono);font-size:0.85rem;">' + conf + '</td>' +
          '<td><span class="verdict-tag verdict-' + vc + '">' + vc + '</span></td>';
        tbody.appendChild(row);
      });
    }

    var overallEl = document.getElementById('footer-overall');
    if (pass === 0 && flag === 0 && block === 0) {
      overallEl.textContent = 'OVERALL: NO CLAIMS';
      overallEl.style.color = 'var(--text-muted)';
    } else if (block > 0 && flag > 0) {
      overallEl.textContent = 'OVERALL: VERIFIED WITH FLAGS';
      overallEl.style.color = 'var(--accent-orange)';
    } else if (block > 0) {
      overallEl.textContent = 'OVERALL: BLOCKED';
      overallEl.style.color = 'var(--accent-red)';
    } else if (flag > 0) {
      overallEl.textContent = 'OVERALL: VERIFIED WITH FLAGS';
      overallEl.style.color = 'var(--accent-orange)';
    } else {
      overallEl.textContent = 'OVERALL: VERIFIED';
      overallEl.style.color = 'var(--accent-green)';
    }

    document.getElementById('footer-counts').textContent = pass + ' PASS · ' + flag + ' FLAG · ' + block + ' BLOCK';

    if (data.audit_event_id) {
      document.getElementById('footer-audit').textContent = 'Audit ID: ' + data.audit_event_id;
    } else {
      document.getElementById('footer-audit').textContent = '';
    }

    document.getElementById('results').scrollIntoView({ behavior: 'smooth' });

    var overallVerdict = block > 0 ? 'BLOCK' : (flag > 0 ? 'FLAG' : 'PASS');
    appendAuditRow(query, persona, overallVerdict);
  }

  function doFetch(query) {
    return fetch('https://regulens-api-bnlw.onrender.com/api/query', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query: query, persona: activePersona })
    }).then(function(res) {
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.json();
    });
  }

  function runVerification() {
    var query = document.getElementById('query-input').value.trim();
    if (!query) return;

    var btn = document.getElementById('submit-btn');
    btn.disabled = true;
    document.getElementById('cold-start-msg').style.display = 'none';
    clearTimers();
    showLoadingSteps();

    coldStartTimer = setTimeout(function() {
      document.getElementById('cold-start-msg').style.display = 'block';
    }, 10000);

    function attempt() {
      doFetch(query).then(function(data) {
        clearTimers();
        hideLoadingSteps();
        document.getElementById('cold-start-msg').style.display = 'none';
        btn.disabled = false;
        renderResults(data, query);
      }).catch(function() {
        clearTimers();
        var msg = document.getElementById('cold-start-msg');
        msg.style.display = 'block';
        msg.textContent = '⚠ Waking API — Render free tier cold start. Retrying in 30s...';
        retryTimer = setTimeout(function() { attempt(); }, 30000);
      });
    }

    attempt();
  }

  // Enter to submit, Shift+Enter for newline
  document.getElementById('query-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      runVerification();
    }
  });

  // ── MIC / VOICE INPUT ──
  var isRec = false, recognition = null;
  function toggleMic() {
    var btn = document.getElementById('mic-btn');
    var wave = document.getElementById('wave-row');
    if (!isRec) {
      if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
        recognition = new SR();
        recognition.continuous = false;
        recognition.interimResults = true;
        recognition.lang = 'en-US';
        recognition.onresult = function(e) {
          document.getElementById('query-input').value =
            Array.from(e.results).map(function(r) { return r[0].transcript; }).join('');
        };
        recognition.onend = function() {
          isRec = false;
          btn.classList.remove('rec');
          wave.classList.remove('show');
        };
        recognition.start();
      } else {
        document.getElementById('query-input').value =
          'What are the prohibited AI practices under EU AI Act Article 5?';
        return;
      }
      isRec = true; btn.classList.add('rec'); wave.classList.add('show');
    } else {
      if (recognition) recognition.stop();
      isRec = false; btn.classList.remove('rec'); wave.classList.remove('show');
    }
  }

  // ── SAMPLE QUERIES ──
  function setSampleQuery(text) {
    var ta = document.getElementById('query-input');
    ta.value = text;
    ta.focus();
  }

  var TYPING_QUERIES = [
    'What does EU AI Act Article 9 require for high-risk AI systems?',
    'What are the prohibited practices under EU AI Act Article 5?',
    'How does the NIST AI RMF GOVERN function apply to AI risk management?',
    'What human oversight controls does ISO 42001 Clause 6 require?',
    'What transparency obligations apply under EU AI Act Articles 13 and 14?'
  ];
  var tqIdx = 0, tqPos = 0, tqDel = false;
  function typeTick() {
    var el = document.getElementById('query-input');
    if (!el || document.activeElement === el || el.value.trim()) {
      setTimeout(typeTick, 1500); return;
    }
    var q = TYPING_QUERIES[tqIdx];
    if (!tqDel) {
      el.placeholder = q.slice(0, tqPos + 1);
      tqPos++;
      if (tqPos >= q.length) { tqDel = true; setTimeout(typeTick, 2000); return; }
    } else {
      el.placeholder = q.slice(0, tqPos - 1);
      tqPos--;
      if (tqPos <= 0) {
        tqDel = false;
        tqIdx = (tqIdx + 1) % TYPING_QUERIES.length;
        setTimeout(typeTick, 500); return;
      }
    }
    setTimeout(typeTick, tqDel ? 30 : 55);
  }
  setTimeout(typeTick, 2000);

  // ── FILE ATTACH ──
  var attachedFile = null;
  function handleFile(input) {
    if (!input.files.length) return;
    attachedFile = input.files[0];
    var label = document.getElementById('file-label');
    label.innerHTML = '<span class="file-tag">' +
      '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
      '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>' +
      '<polyline points="14,2 14,8 20,8"/></svg>' +
      escapeHtml(attachedFile.name) +
      '<span class="file-clear" onclick="clearFile(event)">&#x2715;</span></span>';
  }
  function clearFile(e) {
    e.stopPropagation();
    attachedFile = null;
    document.getElementById('file-input').value = '';
    document.getElementById('file-label').innerHTML =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;flex-shrink:0">' +
      '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>' +
      '<polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>' +
      'Attach document';
  }

  // ── AUDIT LOG ──
  function appendAuditRow(query, persona, verdict) {
    var h = Math.random().toString(36).substr(2,6) + '…' + Math.random().toString(36).substr(2,4);
    var now = new Date();
    var ts = now.getFullYear() + '-' +
      String(now.getMonth()+1).padStart(2,'0') + '-' +
      String(now.getDate()).padStart(2,'0') + ' ' +
      String(now.getHours()).padStart(2,'0') + ':' +
      String(now.getMinutes()).padStart(2,'0');
    var vColor = verdict === 'PASS' ? 'rgba(0,255,102,0.1)' :
                 verdict === 'FLAG' ? 'rgba(255,153,0,0.1)' : 'rgba(255,51,51,0.1)';
    var vText = verdict === 'PASS' ? 'var(--accent-green)' :
                verdict === 'FLAG' ? 'var(--accent-orange)' : 'var(--accent-red)';
    var pColor = persona === 'ml_engineer' ? '#88aaff' : '#8899ff';
    var row = document.createElement('tr');
    row.style.animation = 'auditRise 0.3s ease';
    row.innerHTML =
      '<td style="padding:1rem 0;border-bottom:1px solid #111;color:var(--text-muted);font-family:var(--font-mono);font-size:0.8rem;">' + ts + '</td>' +
      '<td style="padding:1rem 0;border-bottom:1px solid #111;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + escapeHtml(query) + '</td>' +
      '<td style="padding:1rem 0;border-bottom:1px solid #111;"><span style="font-family:var(--font-mono);font-size:0.75rem;font-weight:bold;background:rgba(100,120,255,0.1);color:' + pColor + ';padding:0.2rem 0.5rem;border-radius:3px;">' + escapeHtml(persona) + '</span></td>' +
      '<td style="padding:1rem 0;border-bottom:1px solid #111;"><span style="font-family:var(--font-mono);font-size:0.75rem;font-weight:bold;background:' + vColor + ';color:' + vText + ';padding:0.2rem 0.5rem;border-radius:3px;">' + verdict + '</span></td>' +
      '<td style="padding:1rem 0;border-bottom:1px solid #111;font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);">' + h + '</td>';
    document.getElementById('audit-body').prepend(row);
  }
</script>
</body>
</html>

